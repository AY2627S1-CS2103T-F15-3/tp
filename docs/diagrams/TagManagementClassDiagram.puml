@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
top to bottom direction

class TagCommand LOGIC_COLOR
class UntagCommand LOGIC_COLOR
class Person MODEL_COLOR {
  +getTags(): Set<Tag>
}
class Tag MODEL_COLOR {
  +tagName: String
}
class DefaultTags MODEL_COLOR
TagCommand ..> Person : adds tags
UntagCommand ..> Person : removes tags
Person --> "0..*" Tag : tags
DefaultTags --> "5" Tag : TAGS {ordered}

note bottom of Person
  getTags() exposes an unmodifiable set.
  Commands preserve all other contact fields.
end note
@enduml
