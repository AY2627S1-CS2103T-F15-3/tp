@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam ArrowFontStyle plain
top to bottom direction

class FavCommand
class UnfavCommand
class ListFavCommand
class Person MODEL_COLOR {
  -favourite: boolean
  +isFavourite(): boolean
}
class FavouritePredicate MODEL_COLOR {
  +test(person: Person): boolean
}

FavCommand ..> Person
UnfavCommand ..> Person
ListFavCommand ..> FavouritePredicate
FavouritePredicate ..> Person

note bottom of Person
  Favourite status is independent of ordinary tags.
  Replacement preserves all other contact fields.
end note
note bottom of FavouritePredicate
  Filtering changes the view, not stored contacts.
  The current sorting is preserved.
end note
@enduml
