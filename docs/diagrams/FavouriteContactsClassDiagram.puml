@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
top to bottom direction

class FavCommand
class UnfavCommand
class ListFavCommand
class Person MODEL_COLOR {
  -favourite: boolean
  +isFavourite(): boolean
}
class PersonCard UI_COLOR
FavCommand ..> Person : favourite\n= true
UnfavCommand ..> Person : favourite\n= false
ListFavCommand ..> Person : selects favourites
PersonCard --> "1" Person : person

note bottom of PersonCard
  The favourite flag controls the red heart.
end note
@enduml
