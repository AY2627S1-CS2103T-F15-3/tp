@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":SortCommandParser" as Parser LOGIC_COLOR
participant "s:SortCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "c:PersonSortComparator" as Comparator MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> Parser : parse(" year desc")
activate Parser
create Command
Parser -> Command : SortCommand(YEAR, DESC)
[<-- Parser : s
deactivate Parser

...

[-> Command : execute(m)
activate Command
create Comparator
Command -> Comparator : PersonSortComparator(YEAR, DESC)
Command -> Model : updateSortedPersonList(c)
activate Model
Model --> Command
deactivate Model
[<-- Command : result
deactivate Command
@enduml
