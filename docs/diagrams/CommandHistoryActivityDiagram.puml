@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam Participant {
    FontColor #222222
    BackgroundColor #F4F4F4
    BorderColor #666666
}

participant "Older\ncommand" as Older
participant "Most recent\ncommand" as Recent
participant "Your draft\n(not submitted)" as Draft

Draft -> Recent : Up (draft kept)
Recent -> Older : Up
Older -> Recent : Down
Recent -> Draft : Down (draft restored)

legend bottom
  Arrow keys recall text; press Enter to run it.
  Alt+Up/Down recalls commands starting with
  your typed prefix (Option on macOS).
endlegend
@enduml
