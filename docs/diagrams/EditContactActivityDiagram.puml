@startuml
!include style.puml
skinparam ArrowFontStyle plain
start
:Read the contact's number\nin the displayed list;
:Type edit INDEX and the changed fields,\nthen press Enter;
if (Valid fields, displayed index\nand no duplicate name?) then (yes)
  :Update the contact and save automatically;
  :Show the full contact list\nin the current sort order;
  :Show updated details, any tag changes\nand any shared phone/email warning;
  :Clear the command box;
else (no)
  :Show an error and keep\nthe typed command for correction;
  :Keep contacts and the current view unchanged;
endif
stop
@enduml
