@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ActivityFontSize 14
start
:Submit edit using the displayed index;
if (Valid fields, index and name?) then ([yes])
  if (Any contact detail changed?) then ([yes])
    :Replace the contact;
    :Show all contacts;
    :Record the previous state for undo;
    :Build change summary and warnings;
  else ([no])
    :Keep contact data and history;
    :Show all contacts;
    :Build no-change feedback;
  endif
  :Save automatically;
  :Show feedback and clear the command box;
else ([no])
  :Show an error and keep the input;
  :Leave contacts and view unchanged;
endif
stop
@enduml
