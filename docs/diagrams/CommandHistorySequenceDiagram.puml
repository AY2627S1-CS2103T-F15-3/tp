@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":CommandBox" as Box UI_COLOR
participant ":CommandHistory" as History UI_COLOR
participant ":CommandExecutor" as Executor UI_COLOR
participant ":TextField" as Field UI_COLOR
end box

[-> Box : user pass in a command
activate Box

Box -> History : record command
activate History
History --> Box
deactivate History

Box -> Executor : execute command
activate Executor
Executor --> Box
deactivate Executor

[<-- Box
deactivate Box

[-> Box : user press Alt + Up
activate Box

Box -> History : find older command\nstarting with input
activate History
History --> Box : match
deactivate History

opt match found
    Box -> Field : show match
    activate Field
    Field --> Box
    deactivate Field
end

[<-- Box
deactivate Box

@enduml
