@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant "commandTextField:TextField" as Field UI_COLOR
participant ":CommandBox" as Box UI_COLOR
participant ":CommandHistory" as History UI_COLOR
participant "commandExecutor:CommandExecutor" as Executor UI_COLOR

== Non-empty submission ==
Field -> Box : handleCommandEntered()
activate Box
Box -> Box : hideHistoryPosition()
Box -> History : add(commandText)
note right of History
  Append even duplicate or invalid input.
  Reset position to commands.size(), draft and prefix.
end note
Box -> Executor : execute(commandText)
alt Execution succeeds
  Executor --> Box : CommandResult
  Box -> Field : setText("")
else ParseException or CommandException
  Executor --> Box : exception
  Box -> Box : setStyleToIndicateCommandFailure()
  note over Field : Keep submitted text for correction.
end
 deactivate Box

== Browse without executing ==
Field -> Box : handleHistoryNavigation(event)
activate Box
alt Alt+Up (Option+Up on macOS)
  Box -> History : previousMatching(currentInput)
  note right of History
    Capture prefix if no search is active.
    Save draft only at end; skip non-matches.
    No older match leaves cursor unchanged.
  end note
  History --> Box : older match / null
else Alt+Down (Option+Down on macOS)
  Box -> History : nextMatching()
  History --> Box : newer match / saved draft / null
  note right of History
    Without active search: null.
    After newest match: restore draft and reset prefix.
  end note
else Ordinary Up key
  Box -> History : previous(currentInput)
  History --> Box : previous command (or null if empty)
  note right of History : Reset prefix; save draft only when leaving the end.
else Ordinary Down key
  Box -> History : next()
  History --> Box : newer command / saved draft / null
  note right of History : Reset prefix; keep original draft.
end
opt Returned text is not null
  Box -> Box : recallingHistory = true
  Box -> Field : setText(text)
  note over Box : Text listener clears error style, keeps prefix.
  Box -> Field : positionCaret(text.length())
  Box -> Box : recallingHistory = false
end
Box -> Box : showHistoryPosition()
Box -> History : getPosition(), size()
History --> Box : absolute position (0 at draft), total
alt Browsing a stored entry
  Box -> Box : Show label "History i/N"\nrestart 200 ms opacity pulse
  note over Box : Feedback also restarts for duplicates and boundary presses.
else At draft or empty history
  Box -> Box : hideHistoryPosition()\nstop transition, hide and unmanage label
end
Box -> Box : event.consume()
deactivate Box
note over Box, Executor : Browsing does not call the executor.

== Edit input ==
Field -> Box : text property changed (not recallingHistory)
Box -> History : resetPrefixSearch()
note right of History
  Next search uses edited text at current cursor.
  Original saved draft is preserved.
end note
@enduml
