@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":CommandBox" as Box UI_COLOR
participant ":CommandHistory" as History UI_COLOR
participant ":CommandExecutor" as Executor UI_COLOR
participant ":TextField" as Field UI_COLOR
end box

[-> Box : handleCommandEntered()
activate Box

Box -> History : add(commandText)
activate History
History --> Box
deactivate History

Box -> Executor : execute(commandText)
activate Executor
Executor --> Box
deactivate Executor

[<-- Box
deactivate Box

[-> Box : handleHistoryNavigation(Alt+Up)
activate Box

Box -> History : previousMatching(input)
activate History
History --> Box : match
deactivate History

opt match is not null
    Box -> Field : setText(match)
    activate Field
    Field --> Box
    deactivate Field
end

[<-- Box
deactivate Box

@enduml
