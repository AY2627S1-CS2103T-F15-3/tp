@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":ModelManager" as ModelManager MODEL_COLOR
participant ":AddressBookHistory" as AddressBookHistory MODEL_COLOR
participant ":AddressBook" as AddressBook MODEL_COLOR
end box

[-> ModelManager : undoAddressBook()
activate ModelManager

ModelManager -> AddressBookHistory : undo()
activate AddressBookHistory

AddressBookHistory -> AddressBookHistory : discardIfStale()
activate AddressBookHistory
AddressBookHistory --> AddressBookHistory
deactivate AddressBookHistory

alt undoStates is empty
    AddressBookHistory --> ModelManager : false
else else
    AddressBookHistory -> AddressBookHistory : push currentState\nonto redoStates
    activate AddressBookHistory
    AddressBookHistory --> AddressBookHistory
    deactivate AddressBookHistory

    AddressBookHistory -> AddressBookHistory : restore(undoStates.pop())
    activate AddressBookHistory

    AddressBookHistory -> AddressBook : resetData(state)
    activate AddressBook
    AddressBook --> AddressBookHistory
    deactivate AddressBook

    AddressBookHistory --> AddressBookHistory
    deactivate AddressBookHistory

    AddressBookHistory --> ModelManager : true
end
deactivate AddressBookHistory

[<-- ModelManager
deactivate ModelManager

@enduml
