@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":UndoCommand" as UndoCommand LOGIC_COLOR
participant ":CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("undo")

LogicManager -> AddressBookParser : parse "undo"

create UndoCommand
AddressBookParser -> UndoCommand
UndoCommand --> AddressBookParser

AddressBookParser --> LogicManager

LogicManager -> UndoCommand : execute undo action

UndoCommand -> Model : check if there is a change to undo
Model --> UndoCommand : canUndo

alt canUndo
    UndoCommand -> Model : get description of the change to undo
    Model --> UndoCommand : description

    UndoCommand -> Model : restore the previous contact data
    Model --> UndoCommand

    UndoCommand -> Model : show all contacts
    Model --> UndoCommand

    create CommandResult
    UndoCommand -> CommandResult : "Undid: " + description
    CommandResult --> UndoCommand

    UndoCommand --> LogicManager
    [<-- LogicManager
else else
    UndoCommand --> LogicManager : throw CommandException
    [<-- LogicManager
end

@enduml
