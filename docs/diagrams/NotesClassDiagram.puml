@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR

class NoteCommand LOGIC_COLOR {
  +execute(model: Model): CommandResult
}
class Person {
  +getNotes(): Notes
  +withNotes(updatedNotes: Notes): Person
}
class Notes {
  {static} +EMPTY: Notes
  {static} +MAX_LENGTH: int = 500
  +value: String
  +isEmpty(): boolean
}
NoteCommand ..> Person : reads / replaces
NoteCommand --> "1" Notes : notes
Person --> "1" Notes : notes

note bottom of Notes
  Immutable and non-null; empty means no note.
  Notes.EMPTY is shared, so these are associations.
end note
@enduml
