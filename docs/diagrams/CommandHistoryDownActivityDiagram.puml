@startuml
!include style.puml
skinparam ArrowFontStyle plain
start
:User presses DOWN in the command box;

if () then ([Alt pressed at the same time\n(macOS: Option)])
  :Look for a newer command
  starting with the text in the command box;
else ([else])
  :Look for the next command;
endif

if () then ([command found])
  :Show command;
else ([else])
  if () then ([browsing past commands])
    :Return to the text user was typing;
  else ([else])
    :Keep existing text unchanged;
  endif
endif
stop
@enduml
