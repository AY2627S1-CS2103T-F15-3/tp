@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":FindCommandParser" as Parser LOGIC_COLOR
participant ":FindCommand" as Command LOGIC_COLOR
participant ":CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":PersonContains\nKeywordsPredicate" as Predicate MODEL_COLOR
end box

[-> Parser : parse "Alice Computer"
activate Parser

create Predicate
Parser -> Predicate : keywords
activate Predicate
Predicate --> Parser
deactivate Predicate

create Command
Parser -> Command : find with predicate
activate Command
Command --> Parser
deactivate Command

[<-- Parser
deactivate Parser

[-> Command : execute
activate Command

Command -> Model : show contacts matching predicate
activate Model
Model --> Command
deactivate Model

Command -> Model : get shown contacts
activate Model
Model --> Command
deactivate Model

create CommandResult
Command -> CommandResult : feedback
activate CommandResult
CommandResult --> Command
deactivate CommandResult

[<-- Command
deactivate Command
@enduml
