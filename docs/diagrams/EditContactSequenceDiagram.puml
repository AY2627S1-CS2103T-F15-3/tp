@startuml
!include style.puml
skinparam ArrowFontStyle plain
participant "edit:EditCommand" as Edit LOGIC_COLOR
participant "model:Model" as Model MODEL_COLOR

[-> Edit : execute(model)
Edit -> Model : getFilteredPersonList()
Model --> Edit : displayed contacts
Edit -> Edit : createEditedPerson(person, descriptor)
note right of Edit
  Validate the displayed index and duplicate name
  before changing contact data.
end note
alt Contact unchanged
  Edit -> Model : show all contacts
  Edit -->[ : No changes made feedback
else Contact changed
  Edit -> Model : getAddressBook()
  Model --> Edit : contact data to snapshot
  Edit -> Edit : previousState = new AddressBook(contact data)
  Edit -> Model : setPerson(person, editedPerson)
  Edit -> Model : show all contacts
  Edit -> Model : commitAddressBook(previousState, message)
  note over Edit, Model
    History uses the full-contact description.
  end note
  Edit -> Edit : formatChanges(person, editedPerson)
  Edit -> Edit : append shared-detail warning if needed
  Edit -->[ : changed-field feedback
end
@enduml
