@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
top to bottom direction

class Person {
  +isIncomplete(): boolean
}
class Phone {
  {static} +EMPTY: Phone
  +value: String
}
class Email {
  {static} +EMPTY: Email
  +value: String
}
enum SystemTag {
  INCOMPLETE
}
class PersonCard UI_COLOR
Person --> "1" Phone : phone
Person --> "1" Email : email
SystemTag ..> Person : evaluates completeness
PersonCard --> "1" Person : person
PersonCard ..> SystemTag : renders derived labels

note bottom of Person
  Incomplete means phone and email are both empty.
  Shared EMPTY values remain non-null.
end note
@enduml
