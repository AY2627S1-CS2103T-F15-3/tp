@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam genericDisplay old
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
skinparam ArrowFontStyle plain
top to bottom direction

enum SystemTag <<enumeration>> {
  INCOMPLETE
  {static} +forPerson(person: Person, today: LocalDate): List<SystemTag>
}
class Person {
  +isIncomplete(): boolean
}
class Phone {
  {static} +EMPTY: Phone
  +value: String
}
class Email {
  {static} +EMPTY: Email
  +value: String
}

SystemTag ..> Person
Person --> "1\nphone" Phone
Person --> "1\nemail" Email

note bottom of Person
  Incomplete when both values are empty.
end note
note top of SystemTag
  Only INCOMPLETE shown; derived, not stored.
end note
@enduml
