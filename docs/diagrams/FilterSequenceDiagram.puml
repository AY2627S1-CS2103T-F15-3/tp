@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":FilterCommandParser" as Parser LOGIC_COLOR
participant "f:FilterCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:ContactFilterPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> Parser : parse(args)
activate Parser
create Predicate
Parser -> Predicate : ContactFilterPredicate(major, year, tag)
create Command
Parser -> Command : FilterCommand(p)
[<-- Parser : f
deactivate Parser

...

[-> Command : execute(m)
activate Command
Command -> Model : updateFilteredPersonList(p)
activate Model
Model --> Command
deactivate Model
Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : displayedContacts
deactivate Model
[<-- Command : result with match count
deactivate Command
@enduml
