@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":FilterCommandParser" as Parser LOGIC_COLOR
participant "f:FilterCommand" as Command LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "p:ContactFilterPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> Parser : parse(args)
activate Parser

note right of Parser
  Validates the m/, c/ and t/ criteria.
  At least one criterion is required.
end note

create Predicate
Parser -> Predicate : ContactFilterPredicate(major, year, tag)
activate Predicate
Predicate --> Parser
deactivate Predicate

create Command
Parser -> Command : FilterCommand(p)
activate Command
Command --> Parser
deactivate Command

[<-- Parser : 
deactivate Parser

[-> Command : execute(m)
activate Command

Command -> Model : updateFilteredPersonList(p)
activate Model
Model --> Command
deactivate Model

Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : filteredList
deactivate Model

create CommandResult
Command -> CommandResult : number of matched contacts
activate CommandResult
CommandResult --> Command
deactivate CommandResult

[<-- Command : 
deactivate Command

@enduml
