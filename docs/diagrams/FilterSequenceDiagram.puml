@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":FilterCommandParser" as Parser LOGIC_COLOR
participant ":FilterCommand" as Command LOGIC_COLOR
participant ":CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":ContactFilterPredicate" as Predicate MODEL_COLOR
participant ":Model" as Model MODEL_COLOR
end box

[-> Parser : parse filter criteria
activate Parser

create Predicate
Parser -> Predicate : major, year, tag
activate Predicate
Predicate --> Parser
deactivate Predicate

create Command
Parser -> Command : get predicate
activate Command
Command --> Parser
deactivate Command

[<-- Parser
deactivate Parser

[-> Command : execute
activate Command

Command -> Model : show contacts matching predicate
activate Model
Model --> Command
deactivate Model

Command -> Model : get shown contacts
activate Model
Model --> Command
deactivate Model

create CommandResult
Command -> CommandResult : get number of matched contacts
activate CommandResult
CommandResult --> Command
deactivate CommandResult

[<-- Command
deactivate Command
@enduml
