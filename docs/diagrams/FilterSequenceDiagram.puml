
@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":FilterCommandParser" as Parser LOGIC_COLOR
participant "f:FilterCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "predicate:\nContactFilterPredicate" as Predicate MODEL_COLOR
participant "m:Model" as Model MODEL_COLOR
end box

[-> Parser : parse(args)
activate Parser

Parser -> Parser : parseCriteria(args)

note right of Parser
  Validates supplied prefixes and criteria.
  Parses optional major, graduation year,
  and tag values.
  At least one criterion must be present.
end note

create Predicate
Parser -> Predicate : ContactFilterPredicate(major, year, tag)
activate Predicate
Predicate --> Parser : predicate
deactivate Predicate

create Command
Parser -> Command : FilterCommand(predicate)
activate Command
deactivate Command

[<-- Parser : f
deactivate Parser

[-> Command : execute(m)
activate Command

Command -> Model : updateFilteredPersonList(predicate)
activate Model
Model --> Command
deactivate Model

Command -> Model : getFilteredPersonList()
activate Model
Model --> Command : filteredPersonList
deactivate Model

note right of Command
  Obtains the number of matched contacts
  using filteredPersonList.size().
  Returns a CommandResult containing
  the match count.
end note

[<-- Command : CommandResult
deactivate Command

@enduml
