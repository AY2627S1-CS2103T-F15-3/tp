@startuml
!include style.puml
skinparam ArrowFontStyle plain
start
:User presses UP in the command box;

if () then ([Alt pressed at the same time\n(macOS: Option)])
  :Look for an older command
  starting with the text in the command box;
else ([else])
  :Look for the previous command;
endif

if () then ([command found])
  :Show command;
else ([else])
  :Keep existing text unchanged;
endif
stop
@enduml
