@startuml
!include style.puml
show members
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
top to bottom direction

class Person {
  -lastUpdated: LocalDate
  +needsUpdate(today: LocalDate): boolean
}
enum SystemTag {
  UPDATE
}
class PersonCard UI_COLOR
class JsonAdaptedPerson STORAGE_COLOR {
  -lastUpdated: String
  +toModelType(): Person
}
SystemTag ..> Person : evaluates needsUpdate(today)
PersonCard --> "1" Person : person
PersonCard ..> SystemTag : renders derived labels
JsonAdaptedPerson ..> Person : converts ISO date

note bottom of Person
  UPDATE applies only after the one-year anniversary.
  Missing/null dates remain unknown: no age reminder.
end note
@enduml
